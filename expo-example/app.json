{
  "expo": {
    "name": "DocumentKit Expo",
    "slug": "document-kit-expo-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.documentkit.expoexample"
    },
    "android": {
      "package": "com.documentkit.expoexample",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-document-kit",
        {
          "cameraPermission": "Take photos and videos to attach.",
          "microphonePermission": "Record sound with your videos."
        }
      ]
    ]
  }
}
